{% extends "archive_base.html.j2" %}
{% block title %}{{ title }}{% endblock %}
{% block body %}
{% if back_href %}<nav><a href="{{ back_href }}">{{ back_label }}</a></nav>
{% endif %}<main>
<h1>{{ heading }}</h1>
<ul class="entries">
{% for entry in entries %}<li><a href="{{ entry.href }}">{{ entry.label }}</a>{% if entry.detail %} <span class="detail">{{ entry.detail }}</span>{% endif %}</li>
{% endfor %}</ul>
</main>
{% endblock %}
