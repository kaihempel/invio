<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<meta name="referrer" content="no-referrer">
<title>{% block title %}{% endblock %}</title>
<style>
:root{color-scheme:light dark}
body{margin:0;padding:16px;background:#f5f5f5;color:#222;font-family:system-ui,-apple-system,"Segoe UI",Helvetica,Arial,sans-serif;line-height:1.5}
main,footer,nav{max-width:42rem;margin-left:auto;margin-right:auto}
main{background:#fff;padding:16px 20px;border-radius:6px;overflow-wrap:anywhere}
h1{font-size:1.5rem;margin:0 0 4px 0;overflow-wrap:anywhere}
.date{margin:0 0 24px 0;color:#666;font-size:.875rem}
a{color:#0b5cad}
pre{overflow-x:auto}
code{overflow-wrap:anywhere}
table{display:block;max-width:100%;overflow-x:auto;border-collapse:collapse}
th,td{border:1px solid #ccc;padding:4px 8px}
ul.entries{list-style:none;padding:0}
ul.entries li{padding:6px 0;border-bottom:1px solid #eee}
.detail{color:#666;font-size:.875rem}
footer{margin-top:16px;color:#888;font-size:.75rem}
nav{margin-bottom:12px;font-size:.875rem}
@media (prefers-color-scheme:dark){
body{background:#121212;color:#e6e6e6}
main{background:#1c1c1c}
a{color:#7ab7ff}
.date,.detail{color:#aaa}
footer{color:#999}
th,td{border-color:#444}
ul.entries li{border-color:#333}
}
</style>
</head>
<body>
{% block body %}{% endblock %}
</body>
</html>
