# Example server env file for invio. Placeholders only: never put real secrets in this repository.
#
# Install as /etc/invio/invio.env, owned by root:invio with mode 0640, in the directory
# /etc/invio/ (root:invio 0750). The systemd units read it with EnvironmentFile=.
#
# Format: systemd EnvironmentFile syntax, one KEY="value" per line. Write a backslash as \\ and
# a double quote as \". Values must not contain newlines. systemd does not expand $VARIABLES in
# double-quoted values the way a shell does, but invio's own dotenv parser would if you pointed
# INVIO_ENV_FILE at this file, so do not set INVIO_ENV_FILE on a server.
# The Ansible role "invio" writes this file for you (deploy/ansible/roles/invio).

# Database. A password with special characters must be URL-encoded here.
INVIO_DATABASE_URL="mysql+pymysql://invio:change-me@localhost:3306/invio?charset=utf8mb4&unix_socket=/run/mysqld/mysqld.sock"

# E-mail notifications (SMTP)
INVIO_SMTP_HOST="smtp.example.com"
INVIO_SMTP_PORT="587"
INVIO_SMTP_SECURITY="starttls"
INVIO_SMTP_FROM="Invio <invio@example.com>"
INVIO_SMTP_USER="invio@example.com"
INVIO_SMTP_PASSWORD="change-me"

# LLM providers: set at least one
INVIO_MISTRAL_API_KEY="change-me"
INVIO_OPENAI_API_KEY="change-me"
INVIO_ANTHROPIC_API_KEY="change-me"
INVIO_GOOGLE_API_KEY="change-me"

# Operations
INVIO_LOG_LEVEL="INFO"
# Contact for site owners, sent in the User-Agent header of source requests
INVIO_HTTP_CONTACT="admin@example.com"
INVIO_ARCHIVE_DIR="/var/lib/invio/archive"
# A healthcheck URL is a capability: treat it as a secret
INVIO_HEALTHCHECK_URL="https://hc-ping.example.com/change-me"
