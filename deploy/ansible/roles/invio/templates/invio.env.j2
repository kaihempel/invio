{% macro q(v) %}{% if '\n' in (v | string) or '\r' in (v | string) %}{{ invio_value_contains_a_newline() }}{% endif %}"{{ v | string | replace('\\', '\\\\') | replace('"', '\\"') }}"{% endmacro %}
# Managed by Ansible role invio - do not edit; changes are overwritten on the next run.
# systemd EnvironmentFile syntax: KEY="value", backslash written as \\ and quote as \".
# Do not point INVIO_ENV_FILE at this file: python-dotenv would expand ${...} in values.
{% set _ = q(invio_db_user ~ invio_db_password ~ invio_db_host ~ invio_db_name) %}
INVIO_DATABASE_URL={{ q('mysql+pymysql://' ~ (invio_db_user | urlencode | replace('/', '%2F')) ~ ':' ~ (invio_db_password | urlencode | replace('/', '%2F')) ~ '@' ~ invio_db_host ~ ':' ~ invio_db_port ~ '/' ~ invio_db_name ~ '?charset=utf8mb4' ~ ('&unix_socket=/run/mysqld/mysqld.sock' if (invio_db_host == 'localhost' and invio_mariadb_manage_server) else '')) }}
INVIO_SMTP_HOST={{ q(invio_smtp_host) }}
INVIO_SMTP_PORT={{ q(invio_smtp_port) }}
INVIO_SMTP_SECURITY={{ q(invio_smtp_security) }}
INVIO_SMTP_FROM={{ q(invio_smtp_from) }}
{% if invio_smtp_user is defined and invio_smtp_user %}
INVIO_SMTP_USER={{ q(invio_smtp_user) }}
{% endif %}
{% if invio_smtp_password is defined and invio_smtp_password %}
INVIO_SMTP_PASSWORD={{ q(invio_smtp_password) }}
{% endif %}
{% for provider, key in invio_llm_api_keys | dictsort %}
{% if key %}
INVIO_{{ provider | upper }}_API_KEY={{ q(key) }}
{% endif %}
{% endfor %}
INVIO_LOG_LEVEL={{ q(invio_log_level) }}
INVIO_HTTP_CONTACT={{ q(invio_http_contact) }}
INVIO_ARCHIVE_DIR="/var/lib/invio/archive"
{% if invio_healthcheck_url is defined and invio_healthcheck_url %}
INVIO_HEALTHCHECK_URL={{ q(invio_healthcheck_url) }}
{% endif %}
{% for name, value in invio_env_extra | dictsort %}
{{ name }}={{ q(value) }}
{% endfor %}
