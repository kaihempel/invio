# Copy to .env and fill in real values. Never commit .env.

# --- Database (MariaDB in production, SQLite/MariaDB in tests) ---
SCOUT_DATABASE_URL=mysql+pymysql://scout:change-me@localhost:3306/scout?charset=utf8mb4
SCOUT_TEST_DATABASE_URL=sqlite:///./scout-test.sqlite

# --- LLM providers (set only the ones you use) ---
SCOUT_MISTRAL_API_KEY=your-mistral-api-key
SCOUT_OPENAI_API_KEY=your-openai-api-key
SCOUT_ANTHROPIC_API_KEY=your-anthropic-api-key
SCOUT_GOOGLE_API_KEY=your-google-api-key
SCOUT_OLLAMA_BASE_URL=http://localhost:11434

# --- E-mail notifications (SMTP) ---
SCOUT_SMTP_HOST=smtp.example.com
SCOUT_SMTP_PORT=587
SCOUT_SMTP_USER=scout@example.com
SCOUT_SMTP_PASSWORD=change-me
SCOUT_SMTP_FROM=Scout <scout@example.com>
SCOUT_SMTP_STARTTLS=true

# --- Operations ---
SCOUT_LOG_LEVEL=INFO
SCOUT_HEALTHCHECK_URL=https://hc-ping.com/your-check-uuid
SCOUT_ARCHIVE_DIR=/var/lib/scout/archive

# --- YouTube source (optional) ---
SCOUT_YOUTUBE_COOKIES_FILE=/path/to/youtube-cookies.txt
SCOUT_YOUTUBE_PROXY=http://user:pass@proxy.example.com:8080

# --- Transcription (Whisper model size: tiny, base, small, medium, large-v3) ---
SCOUT_WHISPER_MODEL_SIZE=small
