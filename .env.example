# Copy to .env and fill in real values. Never commit .env.

# --- Database (MariaDB in production, SQLite/MariaDB in tests) ---
INVIO_DATABASE_URL=mysql+pymysql://invio:change-me@localhost:3306/invio?charset=utf8mb4
# Persistence tests (`pytest -m db`): any sqlite URL (e.g. sqlite://) means in-memory SQLite;
# a MariaDB URL runs them on that (empty!) database, e.g.
# mysql+pymysql://root@127.0.0.1:3306/invio_test?charset=utf8mb4
INVIO_TEST_DATABASE_URL=sqlite://

# --- LLM providers (set only the ones you use) ---
# check it with: invio llm test mistral
INVIO_MISTRAL_API_KEY=your-mistral-api-key
INVIO_OPENAI_API_KEY=your-openai-api-key
INVIO_ANTHROPIC_API_KEY=your-anthropic-api-key
INVIO_GOOGLE_API_KEY=your-google-api-key
INVIO_OLLAMA_BASE_URL=http://localhost:11434
# per-request LLM call timeout in seconds
INVIO_LLM_TIMEOUT_SECONDS=60

# --- E-mail notifications (SMTP) ---
INVIO_SMTP_HOST=smtp.example.com
INVIO_SMTP_PORT=587
INVIO_SMTP_USER=invio@example.com
INVIO_SMTP_PASSWORD=change-me
INVIO_SMTP_FROM=Invio <invio@example.com>
INVIO_SMTP_STARTTLS=true

# --- Operations ---
INVIO_LOG_LEVEL=INFO
INVIO_HEALTHCHECK_URL=https://hc-ping.com/your-check-uuid
INVIO_ARCHIVE_DIR=/var/lib/invio/archive

# --- YouTube source (optional) ---
INVIO_YOUTUBE_COOKIES_FILE=/path/to/youtube-cookies.txt
INVIO_YOUTUBE_PROXY=http://user:pass@proxy.example.com:8080

# --- Transcription (Whisper model size: tiny, base, small, medium, large-v3) ---
INVIO_WHISPER_MODEL_SIZE=small
